---
import Layout from "../../layouts/Layout.astro";
import { ambilPaket, PAKET, type PaketMeta } from "../../lib/soal";

export function getStaticPaths() {
  return Object.values(PAKET).map((meta) => ({ params: { slug: meta.slug }, props: { meta } }));
}

const { meta } = Astro.props as { meta: PaketMeta };
const soal = ambilPaket(meta.slug);
const data = JSON.stringify({ meta, soal }).replace(/</g, "\\u003c");
---

<Layout title={`${meta.judul} — Latihan Soal TKAku`} description={meta.deskripsi}>
  <header class="bar">
    <a class="kembali" href="/soal/">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 18l-6-6 6-6" /></svg>
      Paket
    </a>
    <div class="bar-tengah">
      <span class="judul-bar">{meta.judul}</span>
      <span class="progres-teks" id="progres-teks">Soal 1 dari 25</span>
    </div>
    <button class="suara" id="suara" type="button" aria-label="Suara efek" aria-pressed="true"></button>
  </header>
  <div class="bar-progres" aria-hidden="true"><i id="bar-progres"></i></div>

  <main class="bungkus">
    <section class="kolom">
      <article class="kartu" id="kartu">
        <div class="konfeti" id="konfeti" aria-hidden="true"></div>
        <div class="kartu-atas">
          <span class="topik" id="topik"></span>
          <span class="tipe-soal" id="tipe-soal"></span>
        </div>
        <div class="isi" id="isi"></div>
        <div class="area-jawab" id="area"></div>
        <div class="umpan" id="umpan" hidden></div>
        <div class="aksi" id="aksi"></div>
        <section class="pembahasan" id="pembahasan" hidden>
          <h3>Pembahasan</h3>
          <div id="kunci-teks"></div>
          <div id="langkah"></div>
        </section>
      </article>
    </section>

    <aside class="peta" id="peta">
      <div class="peta-atas">
        <h3>Daftar soal</h3>
        <button class="tutup-peta" id="tutup-peta" type="button" aria-label="Tutup daftar soal">✕</button>
      </div>
      <p class="skor" id="skor"></p>
      <div class="peta-grid" id="peta-grid"></div>
      <p class="selesai-pesan" id="selesai-pesan" hidden></p>
      <button class="ulang" id="ulang" type="button">Ulangi dari awal</button>
    </aside>
    <div class="tirai" id="tirai" hidden></div>
  </main>

  <nav class="navigasi">
    <button class="nav-btn" id="prev" type="button">← Sebelumnya</button>
    <button class="nav-btn peta-btn" id="buka-peta" type="button">Daftar soal</button>
    <button class="nav-btn utama" id="next" type="button">Selanjutnya →</button>
  </nav>

  <script type="application/json" id="paket-data" set:html={data}></script>
</Layout>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
    background: rgba(255, 253, 247, 0.9);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(38, 43, 41, 0.07);
  }

  .kembali {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--hijau-700);
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 999px;
    background: var(--hijau-100);
    flex-shrink: 0;
  }

  .bar-tengah {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .judul-bar {
    font-weight: 800;
    font-size: 0.98rem;
    color: var(--ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 46vw;
  }

  .progres-teks {
    font-size: 0.78rem;
    color: var(--ink-soft);
    font-weight: 600;
  }

  .suara {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(38, 43, 41, 0.1);
    background: #fff;
    color: var(--hijau-700);
    display: grid;
    place-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .bar-progres {
    height: 4px;
    background: var(--abu-100);
  }

  .bar-progres i {
    display: block;
    height: 100%;
    width: 4%;
    background: var(--hijau-500);
    border-radius: 0 4px 4px 0;
  }

  .bungkus {
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 16px calc(104px + env(safe-area-inset-bottom));
    display: grid;
    gap: 20px;
    grid-template-columns: minmax(0, 1fr);
  }

  .kartu {
    position: relative;
    background: #fff;
    border: 1px solid rgba(38, 43, 41, 0.08);
    border-radius: var(--radius-besar);
    box-shadow: var(--shadow-kartu);
    padding: 20px 18px 22px;
  }

  .konfeti {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    border-radius: inherit;
  }

  .kartu-atas {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }

  .topik {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--hijau-700);
    background: var(--hijau-100);
    padding: 6px 12px;
    border-radius: 999px;
  }

  .tipe-soal {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--ink-soft);
    border: 1px dashed var(--abu-300);
    padding: 5px 10px;
    border-radius: 999px;
    text-align: right;
  }

  .isi {
    font-size: 1.02rem;
    color: var(--ink);
  }

  .isi :global(p) {
    margin: 0 0 12px;
  }

  .isi :global(p:last-child) {
    margin-bottom: 0;
  }

  .isi :global(.tabel-bungkus) {
    overflow-x: auto;
    margin: 14px 0;
    -webkit-overflow-scrolling: touch;
  }

  .isi :global(table) {
    border-collapse: collapse;
    margin: 0 auto;
  }

  .isi :global(td) {
    border: 1px solid var(--abu-300);
    padding: 8px 12px;
    text-align: center;
    min-width: 44px;
    font-variant-numeric: tabular-nums;
  }

  .isi :global(td.label-tabel) {
    border: none;
    font-weight: 700;
    text-align: left;
    padding-left: 0;
  }

  .area-jawab {
    margin-top: 18px;
    display: grid;
    gap: 10px;
  }

  .umpan {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    padding: 12px 14px;
    border-radius: 14px;
    font-size: 0.96rem;
  }

  .umpan :global(b) {
    font-weight: 800;
  }

  .umpan.benar {
    background: var(--hijau-100);
    color: var(--hijau-900);
  }

  .umpan.benar :global(b) {
    color: var(--hijau-700);
  }

  .umpan.salah {
    background: var(--salah-bg);
    color: var(--salah);
  }

  .umpan.netral {
    background: #eef3fb;
    color: #274b73;
  }

  .umpan.netral :global(b) {
    color: #1d6fa5;
  }

  .aksi {
    margin-top: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .pembahasan {
    margin-top: 20px;
    border-top: 2px dashed var(--hijau-200);
    padding-top: 18px;
  }

  .pembahasan h3 {
    margin: 0 0 10px;
    font-size: 1.05rem;
    color: var(--hijau-700);
  }

  .pembahasan :global(.kunci-baris) {
    margin: 0 0 14px;
    background: var(--hijau-100);
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 0.98rem;
  }

  .pembahasan :global(.langkah) {
    margin-bottom: 14px;
  }

  .pembahasan :global(.langkah-no) {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--hijau-700);
    background: var(--hijau-100);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 6px;
  }

  .pembahasan :global(p) {
    margin: 0 0 8px;
    color: var(--ink);
    font-size: 0.98rem;
  }

  .peta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 60;
    background: #fff;
    border-radius: 22px 22px 0 0;
    box-shadow: 0 -24px 60px -30px rgba(29, 58, 49, 0.55);
    padding: 18px 18px calc(18px + env(safe-area-inset-bottom));
    transform: translateY(110%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    max-height: 82vh;
    overflow-y: auto;
  }

  .peta.terbuka {
    transform: translateY(0);
  }

  .tirai {
    position: fixed;
    inset: 0;
    z-index: 55;
    background: rgba(29, 58, 49, 0.35);
  }

  .peta-atas {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
  }

  .peta-atas h3 {
    margin: 0;
    font-size: 1.05rem;
    color: var(--ink);
  }

  .tutup-peta {
    border: none;
    background: var(--abu-100);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .skor {
    margin: 0 0 12px;
    font-size: 0.9rem;
    color: var(--ink-soft);
  }

  .skor :global(b) {
    color: var(--hijau-700);
  }

  .selesai-pesan {
    margin: 12px 0 0;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--hijau-100);
    color: var(--hijau-900);
    font-weight: 700;
    font-size: 0.92rem;
  }

  .ulang {
    margin-top: 14px;
    width: 100%;
    padding: 12px;
    border-radius: 12px;
    border: 1px solid var(--abu-300);
    background: #fff;
    color: var(--salah);
    font-weight: 700;
    cursor: pointer;
  }

  .navigasi {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: flex;
    gap: 8px;
    padding: 10px 12px calc(10px + env(safe-area-inset-bottom));
    background: rgba(255, 253, 247, 0.94);
    backdrop-filter: blur(12px);
    border-top: 1px solid rgba(38, 43, 41, 0.08);
  }

  .nav-btn {
    flex: 1;
    padding: 13px 10px;
    border-radius: 14px;
    border: 1px solid var(--hijau-200);
    background: #fff;
    color: var(--hijau-700);
    font-weight: 700;
    font-size: 0.92rem;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav-btn.utama {
    background: var(--hijau-700);
    border-color: transparent;
    color: #fff;
  }

  .nav-btn:disabled {
    opacity: 0.4;
    cursor: default;
  }

  @media (max-width: 420px) {
    .nav-btn {
      font-size: 0.85rem;
      padding: 12px 6px;
    }

    .judul-bar {
      max-width: 40vw;
    }
  }

  @media (min-width: 768px) {
    .bungkus {
      padding: 26px 24px calc(110px + env(safe-area-inset-bottom));
    }

    .kartu {
      padding: 28px 30px 30px;
    }

    .isi {
      font-size: 1.08rem;
    }
  }

  @media (min-width: 1024px) {
    .bungkus {
      grid-template-columns: minmax(0, 1fr) 300px;
      align-items: start;
      padding-bottom: 130px;
    }

    .peta {
      position: sticky;
      top: 92px;
      left: auto;
      right: auto;
      bottom: auto;
      z-index: 1;
      transform: none;
      border-radius: var(--radius-besar);
      box-shadow: none;
      border: 1px solid rgba(38, 43, 41, 0.08);
      max-height: calc(100vh - 120px);
      padding: 20px;
    }

    .tutup-peta,
    .peta-btn {
      display: none;
    }

    .tirai {
      display: none !important;
    }

    .navigasi {
      left: 50%;
      right: auto;
      transform: translateX(-50%);
      width: min(720px, calc(100% - 48px));
      bottom: 18px;
      border-radius: 18px;
      border: 1px solid rgba(38, 43, 41, 0.1);
      box-shadow: 0 24px 50px -30px rgba(29, 58, 49, 0.6);
      padding: 10px;
    }

    .nav-btn {
      flex: 0 0 auto;
      padding: 12px 22px;
    }

    .nav-btn.peta-btn {
      display: none;
    }
  }

</style>

<style is:global>
    .opsi-list {
      display: grid;
      gap: 10px;
    }

    .opsi {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      width: 100%;
      text-align: left;
      padding: 14px 14px;
      border-radius: 14px;
      border: 2px solid var(--abu-100);
      background: #fff;
      cursor: pointer;
      font-size: 1rem;
      color: var(--ink);
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.12s ease;
    }

    .opsi:not(:disabled):hover {
      border-color: var(--hijau-200);
      transform: translateY(-1px);
    }

    .opsi .huruf {
      flex: 0 0 32px;
      height: 32px;
      border-radius: 10px;
      background: var(--abu-50);
      display: grid;
      place-items: center;
      font-weight: 800;
      font-size: 0.9rem;
      color: var(--hijau-700);
    }

    .opsi .teks-opsi {
      flex: 1;
      line-height: 1.5;
      padding-top: 3px;
    }

    .opsi .tanda {
      flex: 0 0 24px;
      height: 24px;
      display: grid;
      place-items: center;
      font-weight: 900;
      font-size: 1rem;
    }

    .opsi.terpilih {
      border-color: var(--hijau-500);
      background: var(--hijau-100);
    }

    .opsi.benar {
      border-color: var(--hijau-500);
      background: var(--hijau-100);
    }

    .opsi.benar .huruf {
      background: var(--hijau-500);
      color: #fff;
    }

    .opsi.benar .tanda {
      color: var(--hijau-700);
    }

    .opsi.salah {
      border-color: #d2a096;
      background: var(--salah-bg);
    }

    .opsi.salah .huruf {
      background: var(--salah);
      color: #fff;
    }

    .opsi.salah .tanda {
      color: var(--salah);
    }

    .opsi.dipilih {
      border-color: var(--langit);
      background: #eef3fb;
    }

    .opsi:disabled {
      cursor: default;
    }

    .pernyataan-list {
      display: grid;
      gap: 14px;
    }

    .pernyataan {
      border: 1px solid var(--abu-100);
      border-radius: 14px;
      padding: 14px;
      display: grid;
      gap: 10px;
    }

    .pernyataan .label-p {
      display: inline-block;
      font-size: 0.8rem;
      font-weight: 800;
      color: var(--hijau-700);
      background: var(--hijau-100);
      padding: 3px 10px;
      border-radius: 999px;
      justify-self: start;
    }

    .pernyataan .teks-p {
      line-height: 1.55;
      color: var(--ink);
    }

    .verdict {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .verdict-btn {
      padding: 10px 18px;
      border-radius: 999px;
      border: 2px solid var(--abu-100);
      background: #fff;
      font-weight: 700;
      font-size: 0.95rem;
      color: var(--ink);
      cursor: pointer;
    }

    .verdict-btn.terpilih {
      border-color: var(--hijau-500);
      background: var(--hijau-100);
      color: var(--hijau-900);
    }

    .verdict-btn.benar {
      border-color: var(--hijau-500);
      background: var(--hijau-500);
      color: #fff;
    }

    .verdict-btn.salah {
      border-color: var(--salah);
      background: var(--salah-bg);
      color: var(--salah);
    }

    .verdict-btn:disabled {
      cursor: default;
    }

    .catatan {
      margin: 4px 2px 0;
      font-size: 0.9rem;
      color: var(--ink-soft);
    }

    .tombol {
      padding: 13px 20px;
      border-radius: 14px;
      font-weight: 800;
      font-size: 0.95rem;
      cursor: pointer;
      border: 2px solid transparent;
    }

    .tombol.utama {
      background: var(--hijau-700);
      color: #fff;
    }

    .tombol.utama:disabled {
      opacity: 0.45;
      cursor: default;
    }

    .tombol.lain {
      background: #fff;
      border-color: var(--hijau-200);
      color: var(--hijau-700);
    }

    .peta-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(44px, 1fr));
      gap: 8px;
    }

    .chip-no {
      aspect-ratio: 1;
      border-radius: 12px;
      border: 2px solid var(--abu-100);
      background: #fff;
      font-weight: 800;
      font-size: 0.95rem;
      color: var(--ink-soft);
      cursor: pointer;
    }

    .chip-no.aktif {
      outline: 3px solid var(--hijau-700);
      outline-offset: 1px;
    }

    .chip-no.benar {
      background: var(--hijau-500);
      border-color: var(--hijau-500);
      color: #fff;
    }

    .chip-no.salah {
      background: var(--salah);
      border-color: var(--salah);
      color: #fff;
    }

    .chip-no.netral {
      background: var(--langit);
      border-color: var(--langit);
      color: #fff;
    }

    .konfeti i {
      position: absolute;
      left: 50%;
      top: 30%;
      width: 10px;
      height: 10px;
      display: block;
    }

  @media (prefers-reduced-motion: reduce) {
    .peta {
      transition: none;
    }
  }
</style>

<script>
  import { animate, stagger } from "motion";
  import type { Isi, Soal } from "../../lib/soal";
  import { sfx } from "../../scripts/sfx";

  const el = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const data = JSON.parse(el("paket-data").textContent ?? "{}") as {
    meta: { slug: string; judul: string };
    soal: Soal[];
  };
  const soalList = data.soal;
  const slug = data.meta.slug;
  const total = soalList.length;
  const KUNCI = `tkaku-jawaban-${slug}`;
  const kurangGerak = matchMedia("(prefers-reduced-motion: reduce)").matches;

  const kartu = el("kartu");
  const konfetiWadah = el("konfeti");
  const $topik = el("topik");
  const $tipe = el("tipe-soal");
  const $isi = el("isi");
  const $area = el("area");
  const $umpan = el<HTMLDivElement>("umpan");
  const $aksi = el("aksi");
  const $bahas = el("pembahasan");
  const $kunci = el("kunci-teks");
  const $langkah = el("langkah");
  const $progres = el("bar-progres");
  const $progresTeks = el("progres-teks");
  const $prev = el<HTMLButtonElement>("prev");
  const $next = el<HTMLButtonElement>("next");
  const peta = el("peta");
  const petaGrid = el("peta-grid");
  const $skor = el("skor");
  const $selesaiPesan = el("selesai-pesan");
  const bukaPetaBtn = el<HTMLButtonElement>("buka-peta");
  const tutupPetaBtn = el("tutup-peta");
  const tirai = el("tirai");
  const ulangBtn = el("ulang");
  const suaraBtn = el<HTMLButtonElement>("suara");

  let idx = 0;
  let jawab: Record<number, number[]> = {};
  let pernahSelesai = false;

  try {
    const simpanan = JSON.parse(localStorage.getItem(KUNCI) ?? "null") as { idx?: number; jawab?: Record<number, number[]> } | null;
    if (simpanan) {
      idx = Math.min(Math.max(0, simpanan.idx ?? 0), total - 1);
      jawab = simpanan.jawab ?? {};
    }
  } catch {
    /* abaikan data rusak */
  }

  function simpan() {
    localStorage.setItem(KUNCI, JSON.stringify({ idx, jawab }));
  }

  function esc(t: string): string {
    const d = document.createElement("span");
    d.textContent = t;
    return d.innerHTML;
  }

  function htmlIsi(blok: Isi[]): string {
    return blok
      .map((b) => {
        if ("teks" in b) return `<p>${esc(b.teks)}</p>`;
        const baris = b.tabel
          .map((barisMentah) => {
            const matriks = barisMentah.match(/^\[(.+)\]$/);
            if (matriks) {
              const barisSel = matriks[1].split(";").map((r) => r.trim().split(/\s+/));
              const maks = Math.max(...barisSel.map((r) => r.length));
              return barisSel
                .map((r) => `<tr>${[...r, ...Array(maks - r.length).fill("")].map((x) => `<td>${esc(x)}</td>`).join("")}</tr>`)
                .join("");
            }
            return `<tr><td class="label-tabel">${esc(barisMentah)}</td></tr>`;
          })
          .join("");
        return `<div class="tabel-bungkus"><table>${baris}</table></div>`;
      })
      .join("");
  }

  function verdictOpsi(soal: Soal): string[] {
    return [...new Set(soal.items.map((i) => i.kunci))].sort((a, b) => a.length - b.length);
  }

  type Hasil = "benar" | "salah" | "netral";

  function evaluasi(soal: Soal, p: number[]): Hasil {
    if (soal.tipe === "teks" || soal.tanpaKunci) return "netral";
    if (soal.tipe === "pernyataan") {
      const v = verdictOpsi(soal);
      return soal.items.every((it, i) => v[p[i]] === it.kunci) ? "benar" : "salah";
    }
    const a = [...p].sort((a1, b1) => a1 - b1).join(",");
    const b = [...soal.benar].sort((a1, b1) => a1 - b1).join(",");
    return a === b ? "benar" : "salah";
  }

  const PESAN_BENAR = ["Hebat, jawabanmu benar!", "Tepat sekali!", "Keren, paham banget!", "Sip, mantap!"];
  const PESAN_SALAH = ["Belum tepat, tapi usahamu bagus!", "Hampir! Pelan-pelan ya.", "Gapapa, dari salah jadi paham.", "Coba lihat pembahasan, ketemu polanya!"];

  function tombolAksi(label: string, kelas: string): HTMLButtonElement {
    const b = document.createElement("button");
    b.type = "button";
    b.className = `tombol ${kelas}`;
    b.textContent = label;
    return b;
  }

  function catatan(teks: string) {
    const p = document.createElement("p");
    p.className = "catatan";
    p.textContent = teks;
    $area.append(p);
  }

  function konfeti() {
    if (kurangGerak) return;
    const warna = ["#ffc94d", "#ff7a59", "#5ba9e4", "#9b8afb", "#5ec4a6", "#4f8b6f"];
    for (let n = 0; n < 22; n++) {
      const bit = document.createElement("i");
      bit.style.background = warna[n % warna.length];
      bit.style.borderRadius = n % 3 === 0 ? "50%" : "2px";
      konfetiWadah.append(bit);
      const x = (Math.random() - 0.5) * 300;
      const y = -80 - Math.random() * 120;
      const putar = Math.random() * 720 - 360;
      animate(
        bit,
        { x: [0, x], y: [0, y, 170], opacity: [1, 1, 0], rotate: [0, putar], scale: [0.5, 1, 0.6] },
        { duration: 1 + Math.random() * 0.5, ease: ["easeOut", "easeIn"], onComplete: () => bit.remove() },
      );
    }
  }

  function umpanBlok(jenis: Hasil, pesan: string) {
    $umpan.hidden = false;
    $umpan.className = `umpan ${jenis}`;
    const judul = jenis === "benar" ? "Benar!" : jenis === "salah" ? "Belum tepat" : "Catatan";
    $umpan.innerHTML = `<b>${judul}</b><span>${esc(pesan)}</span>`;
    if (kurangGerak) return;
    animate($umpan, { opacity: [0, 1], y: [8, 0] }, { duration: 0.35 });
    if (jenis === "salah") animate(kartu, { x: [0, -9, 9, -5, 5, 0] }, { duration: 0.4 });
  }

  function bukaPembahasan(gulir: boolean) {
    const soal = soalList[idx];
    $kunci.innerHTML = soal.kunciTeks ? `<p class="kunci-baris">Kunci: <b>${esc(soal.kunciTeks)}</b></p>` : "";
    $langkah.innerHTML = soal.langkah
      .map(
        (l) => `<div class="langkah">${l.nomor ? `<span class="langkah-no">Langkah ${l.nomor}</span>` : ""}${htmlIsi(l.isi)}</div>`,
      )
      .join("");
    $bahas.hidden = false;
    if (!kurangGerak) animate($bahas, { opacity: [0, 1], y: [12, 0] }, { duration: 0.42, ease: [0.16, 1, 0.3, 1] });
    if (gulir) {
      setTimeout(
        () => $bahas.scrollIntoView({ behavior: kurangGerak ? "auto" : "smooth", block: "start" }),
        kurangGerak ? 0 : 140,
      );
    }
  }

  function tombolBahas(sudah: boolean) {
    const b = tombolAksi(sudah ? "Tutup pembahasan" : "Lihat pembahasan", "lain");
    b.addEventListener("click", () => {
      sfx.klik();
      const buka = $bahas.hidden;
      if (buka) bukaPembahasan(false);
      else $bahas.hidden = true;
      b.textContent = buka ? "Tutup pembahasan" : "Lihat pembahasan";
    });
    $aksi.append(b);
  }

  function tombolCobaLagi(soal: Soal) {
    const b = tombolAksi("Coba lagi", "lain");
    b.addEventListener("click", () => {
      delete jawab[soal.no];
      simpan();
      sfx.klik();
      tampil(0, false);
    });
    $aksi.append(b);
  }

  function selesaiJawab(soal: Soal, p: number[]) {
    jawab[soal.no] = p;
    simpan();
    const hasil = evaluasi(soal, p);
    tampil(0, false);
    if (hasil === "benar") {
      sfx.benar();
      umpanBlok("benar", PESAN_BENAR[Math.floor(Math.random() * PESAN_BENAR.length)]);
      konfeti();
    } else if (hasil === "salah") {
      sfx.salah();
      umpanBlok("salah", PESAN_SALAH[Math.floor(Math.random() * PESAN_SALAH.length)]);
    } else {
      sfx.klik();
      umpanBlok("netral", "Soal ini tidak punya kunci otomatis — cocokkan jawabanmu dengan pembahasan, ya.");
    }
    bukaPembahasan(true);
    renderPeta();
  }

  function renderPilihan(soal: Soal, pilihan: number[] | undefined) {
    const wadah = document.createElement("div");
    wadah.className = "opsi-list";
    const sudah = Array.isArray(pilihan);
    const multi = soal.banyakPilihanGanda;
    const set = new Set<number>(sudah ? pilihan : []);

    soal.opsi.forEach((o, i) => {
      const b = document.createElement("button");
      b.type = "button";
      b.className = "opsi";
      b.innerHTML = `<span class="huruf">${o.huruf}</span><span class="teks-opsi">${esc(o.teks)}</span><span class="tanda"></span>`;
      const tanda = b.querySelector<HTMLElement>(".tanda")!;
      if (sudah) {
        b.disabled = true;
        const dipilih = pilihan!.includes(i);
        if (soal.tanpaKunci) {
          if (dipilih) {
            b.classList.add("dipilih");
            tanda.textContent = "•";
          }
        } else {
          const diKunci = soal.benar.includes(i);
          if (diKunci) b.classList.add("benar");
          if (dipilih && !diKunci) b.classList.add("salah");
          tanda.textContent = diKunci ? "✓" : dipilih ? "✕" : "";
        }
      } else {
        b.addEventListener("click", () => {
          if (multi) {
            sfx.klik();
            if (set.has(i)) set.delete(i);
            else set.add(i);
            b.classList.toggle("terpilih", set.has(i));
            const cek = $aksi.querySelector<HTMLButtonElement>("[data-periksa]");
            if (cek) cek.disabled = set.size === 0;
          } else {
            selesaiJawab(soal, [i]);
          }
        });
      }
      wadah.append(b);
    });
    $area.append(wadah);

    if (!sudah && multi) {
      const cek = tombolAksi(soal.tanpaKunci ? "Simpan jawaban" : "Periksa jawaban", "utama");
      cek.disabled = true;
      cek.dataset.periksa = "1";
      cek.addEventListener("click", () => selesaiJawab(soal, [...set].sort((a, b) => a - b)));
      $aksi.append(cek);
      catatan("Boleh pilih lebih dari satu, lalu tekan periksa.");
    } else if (!sudah && !multi) {
      catatan(soal.tanpaKunci ? "Pilih satu jawabanmu, lalu cocokkan dengan pembahasan." : "Pilih satu jawaban — langsung dicek.");
    }
    tombolBahas(sudah);
    if (sudah) tombolCobaLagi(soal);
  }

  function renderPernyataan(soal: Soal, pilihan: number[] | undefined) {
    const v = verdictOpsi(soal);
    const sudah = Array.isArray(pilihan);
    const wadah = document.createElement("div");
    wadah.className = "pernyataan-list";
    const jawabLokal: number[] = [];

    soal.items.forEach((it, i) => {
      const baris = document.createElement("div");
      baris.className = "pernyataan";
      baris.innerHTML = `<span class="label-p">${esc(it.label)}</span><span class="teks-p">${esc(it.teks)}</span>`;
      const grup = document.createElement("div");
      grup.className = "verdict";
      v.forEach((nilai, vi) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "verdict-btn";
        b.textContent = nilai;
        if (sudah) {
          b.disabled = true;
          const dipilih = pilihan![i] === vi;
          const diKunci = it.kunci === nilai;
          if (diKunci) b.classList.add("benar");
          if (dipilih && !diKunci) b.classList.add("salah");
        } else {
          b.addEventListener("click", () => {
            sfx.klik();
            jawabLokal[i] = vi;
            grup.querySelectorAll<HTMLButtonElement>(".verdict-btn").forEach((x, xi) => x.classList.toggle("terpilih", xi === vi));
            if (soal.items.every((_, k) => jawabLokal[k] !== undefined)) {
              selesaiJawab(soal, jawabLokal);
            }
          });
        }
        grup.append(b);
      });
      baris.append(grup);
      wadah.append(baris);
    });
    $area.append(wadah);
    if (!sudah) catatan(`Pilih ${v.join(" atau ")} untuk tiap pernyataan — langsung dicek setelah semua terjawab.`);
    tombolBahas(sudah);
    if (sudah) tombolCobaLagi(soal);
  }

  function renderTeks(soal: Soal, pilihan: number[] | undefined) {
    catatan("Soal ini tidak menyediakan pilihan jawaban. Baca pembahasan untuk jawabannya.");
    if (!pilihan) {
      const b = tombolAksi("Lihat pembahasan & jawaban", "utama");
      b.addEventListener("click", () => {
        jawab[soal.no] = [0];
        simpan();
        sfx.klik();
        tampil(0, false);
        bukaPembahasan(true);
        renderPeta();
      });
      $aksi.append(b);
    } else {
      tombolBahas(true);
    }
  }

  function tipeLabel(soal: Soal): string {
    if (soal.tipe === "teks") return "Isian singkat";
    if (soal.tipe === "pernyataan") return "Benar / Salah";
    if (soal.tanpaKunci) return "Pilihan · kunci manual";
    return soal.banyakPilihanGanda ? "Pilih lebih dari satu" : "Pilihan tunggal";
  }

  function tampil(arah: 1 | -1 | 0, gulir = true) {
    const soal = soalList[idx];
    $topik.textContent = `Soal ${soal.no} · ${soal.topik}`;
    $tipe.textContent = tipeLabel(soal);
    $isi.innerHTML = htmlIsi(soal.isi);
    $area.innerHTML = "";
    $aksi.innerHTML = "";
    $umpan.hidden = true;
    $bahas.hidden = true;

    const pilihan = jawab[soal.no];
    if (soal.tipe === "pilihan") renderPilihan(soal, pilihan);
    else if (soal.tipe === "pernyataan") renderPernyataan(soal, pilihan);
    else renderTeks(soal, pilihan);

    const pct = ((idx + 1) / total) * 100;
    if (kurangGerak) $progres.style.width = `${pct}%`;
    else animate($progres, { width: `${pct}%` }, { duration: 0.5, ease: [0.16, 1, 0.3, 1] });
    $progresTeks.textContent = `Soal ${idx + 1} dari ${total}`;

    $prev.disabled = idx === 0;
    $next.disabled = idx === total - 1;
    $next.textContent = idx === total - 1 ? "Soal terakhir" : "Selanjutnya →";

    renderPeta();
    simpan();

    if (arah && !kurangGerak) {
      animate(kartu, { opacity: [0, 1], x: [arah * 26, 0], scale: [0.985, 1] }, { duration: 0.45, ease: [0.16, 1, 0.3, 1] });
      animate([...$area.children], { opacity: [0, 1], y: [10, 0] }, { delay: stagger(0.04, { startDelay: 0.08 }) });
    }
    if (gulir) window.scrollTo({ top: 0, behavior: kurangGerak ? "auto" : "smooth" });
  }

  function renderPeta(animasi = false) {
    const skor = { benar: 0, salah: 0, netral: 0, kosong: 0 };
    petaGrid.innerHTML = "";
    soalList.forEach((soal, i) => {
      const p = jawab[soal.no];
      const hasil: Hasil | "kosong" = p ? evaluasi(soal, p) : "kosong";
      skor[hasil]++;
      const b = document.createElement("button");
      b.type = "button";
      b.className = `chip-no ${hasil}${i === idx ? " aktif" : ""}`;
      b.textContent = String(soal.no);
      b.setAttribute("aria-label", `Soal ${soal.no}${hasil !== "kosong" ? `, ${hasil}` : ""}`);
      b.addEventListener("click", () => {
        sfx.klik();
        tutupLembar();
        const arah = i > idx ? 1 : -1;
        idx = i;
        tampil(arah);
      });
      petaGrid.append(b);
    });

    const terjawab = total - skor.kosong;
    $skor.innerHTML = `<b>Benar: ${skor.benar}</b> · Salah ${skor.salah} · Terjawab ${terjawab}/${total}`;
    const semua = terjawab === total;
    $selesaiPesan.hidden = !semua;
    if (semua) {
      $selesaiPesan.textContent = `Semua soal selesai — skor benarmu ${skor.benar}/${total}. Kerja bagus!`;
      if (!pernahSelesai) {
        pernahSelesai = true;
        konfeti();
        sfx.benar();
      }
    }
    if (animasi && !kurangGerak) animate([...petaGrid.children], { opacity: [0, 1], scale: [0.85, 1] }, { delay: stagger(0.012) });
  }

  function bukaLembar() {
    peta.classList.add("terbuka");
    tirai.hidden = false;
    renderPeta(true);
  }

  function tutupLembar() {
    peta.classList.remove("terbuka");
    tirai.hidden = true;
  }

  bukaPetaBtn.addEventListener("click", () => {
    sfx.klik();
    bukaLembar();
  });
  tutupPetaBtn.addEventListener("click", () => {
    sfx.klik();
    tutupLembar();
  });
  tirai.addEventListener("click", tutupLembar);

  ulangBtn.addEventListener("click", () => {
    if (!confirm("Hapus semua jawaban di paket ini dan mulai dari soal 1 lagi?")) return;
    jawab = {};
    idx = 0;
    pernahSelesai = false;
    localStorage.removeItem(KUNCI);
    sfx.klik();
    tutupLembar();
    tampil(0);
  });

  $prev.addEventListener("click", () => {
    if (idx === 0) return;
    sfx.klik();
    idx -= 1;
    tampil(-1);
  });

  $next.addEventListener("click", () => {
    if (idx === total - 1) return;
    sfx.klik();
    idx += 1;
    tampil(1);
  });

  addEventListener("keydown", (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === "ArrowRight" && idx < total - 1) {
      idx += 1;
      tampil(1);
    } else if (e.key === "ArrowLeft" && idx > 0) {
      idx -= 1;
      tampil(-1);
    } else if (e.key === "Escape") {
      tutupLembar();
    }
  });

  const IKON_SUARA_ON = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="M15.5 8.5a5 5 0 0 1 0 7"/><path d="M18.5 5.5a9 9 0 0 1 0 13"/></svg>`;
  const IKON_SUARA_OFF = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4V5z"/><path d="m16 9 5 6M21 9l-5 6"/></svg>`;

  function setSuara() {
    suaraBtn.innerHTML = sfx.aktif ? IKON_SUARA_ON : IKON_SUARA_OFF;
    suaraBtn.setAttribute("aria-pressed", String(sfx.aktif));
    suaraBtn.setAttribute("aria-label", sfx.aktif ? "Matikan suara" : "Nyalakan suara");
  }

  suaraBtn.addEventListener("click", () => {
    sfx.setAktif(!sfx.aktif);
    setSuara();
    if (sfx.aktif) sfx.klik();
  });

  setSuara();
  tampil(0, false);
</script>
