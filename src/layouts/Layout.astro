---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Latihan soal TKA Matematika SMA/MA/SMK 2025 dengan kunci jawaban dan pembahasan langkah demi langkah.",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // sembunyikan badge "Powered by Netlify" untuk semua pengunjung
      try {
        localStorage.setItem("nl-hud:public:v1", "hidden");
      } catch {}
    </script>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      import.meta.env.PROD && (
        <script
          is:inline
          defer
          src="https://cloud.umami.is/script.js"
          data-website-id="eefce976-c81e-4a3c-8f02-6a3e5fdebd83"
        />
      )
    }
  </head>
  <body>
    <slot />
  </body>
</html>
